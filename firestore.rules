rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    function bootstrapAdminEnabled() {
      return exists(/databases/$(database)/documents/settings/bootstrap)
        && get(/databases/$(database)/documents/settings/bootstrap).data.enabled == true;
    }

    /* ── ACCOUNTING-02: the one other role allowed into Accounting
       (view/add/edit transactions) — mirrors isAdmin(), no new RBAC. ── */
    function isAccountingStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'accounting';
    }

    /* ── CRM-05 FINALIZATION: the one role allowed into Follow-ups without
       full CRM/admin access — mirrors isAccountingStaff() exactly, same "one
       more allowed role string" shape, no new RBAC system. Investigation
       confirmed no existing role can be reused for this: every other role
       (user/student/instructor/accounting) is unrelated to CRM work, and
       "admin" is the only role that currently does Sales work in production
       — there is no way to give a subset of admins Follow-up-only visibility
       without a role distinct from admin. Scoped to followUps only; every
       other CRM collection (customers/engagements/etc.) below is untouched
       and stays admin-only. ── */
    function isSalesStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'sales';
    }

    /* ── SALES-CRM-01: Sales staff's own Payment Records boundary. An
       engagements `update` from Sales is only allowed to touch paymentRecords
       in one exact shape — append exactly one brand-new record, status
       "pending", no confirmation fields set — computed via list value-diffing
       (no loops/slicing available in rules):
         added   = new list minus everything already in the old list
         missing = old list minus everything still in the new list
       A genuine append has added.size()==1 and missing.size()==0. Mutating,
       reordering-with-change, or deleting an EXISTING record always makes
       `missing` non-empty (the original value is gone), so it's rejected —
       this is what stops Sales from ever confirming/rejecting a payment by
       writing directly to this array (the only place a record's status
       lives), independent of whichever UI buttons happen to be hidden. Every
       record carries a unique `id` (genId()), so two distinct records are
       never value-equal to each other. ── */
    function salesPaymentRecordsAppendOnlyPending(oldData, newData) {
      let oldRecords = oldData.get('paymentRecords', []);
      let newRecords = newData.get('paymentRecords', []);
      let added = newRecords.removeAll(oldRecords);
      let missing = oldRecords.removeAll(newRecords);
      return newRecords.size() == oldRecords.size() + 1
        && missing.size() == 0
        && added.size() == 1
        && added[0].status == 'pending'
        && added[0].get('confirmedAt', null) == null
        && added[0].get('confirmedBy', null) == null
        && added[0].get('rejectionReason', null) == null;
    }

    /* ── SALES-PRICE-01: Sales' own Course Price boundary. `payment` and
       `pricingSnapshot` are already top-level keys Sales may touch (see the
       /engagements update rule below) — but as plain map fields, allowing
       the KEY doesn't by itself restrict which fields INSIDE it change.
       Both maps also hold legacy/derived fields that must stay
       Admin/Accounting-only (`payment.confirmed`/`confirmedAt` are the
       pre-PaymentRecords "is this paid" flag — see utils/paymentRecords.js'
       legacyRecordsFrom, which still reads them as authoritative for an
       engagement with no real paymentRecords yet). These two functions
       nested-diff each map (same value-diffing idea as
       salesPaymentRecordsAppendOnlyPending, via Map.diff().affectedKeys())
       so Sales can only ever change the actual Course Price fields —
       everything else inside either map is rejected even though the map's
       top-level key is allowed. ── */
    function salesPaymentFieldsAllowed(oldData, newData) {
      let oldPayment = oldData.get('payment', {});
      let newPayment = newData.get('payment', {});
      return newPayment.diff(oldPayment).affectedKeys().hasOnly(['coursePrice', 'paymentPlan']);
    }
    function salesPricingSnapshotFieldsAllowed(oldData, newData) {
      let oldSnap = oldData.get('pricingSnapshot', {});
      let newSnap = newData.get('pricingSnapshot', {});
      return newSnap.diff(oldSnap).affectedKeys().hasOnly([
        'originalPrice', 'fullPaymentPrice', 'paymentPlan', 'depositAmount', 'installmentCount'
      ]);
    }

    /* ── users ───────────────────────────────────────── */
    match /users/{userId} {
      /* SALES-CRM-01: Sales staff may additionally read (list included) any
         OTHER user doc whose role is 'sales' — needed only to populate the
         "Assigned Rep" dropdown/filter (ProgramSalesSheet, EngagementDetailModal,
         FollowUpFormModal already relied on this for admins). Sales still
         cannot read admin/accounting/instructor/student profiles. */
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || (isSalesStaff() && resource.data.role == 'sales'));
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && bootstrapAdminEnabled();
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
      );
      allow delete: if isAdmin();
    }

    /* ── settings (bootstrap flag + CRM seedState) ───── */
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || bootstrapAdminEnabled();
      allow delete: if isAdmin() || bootstrapAdminEnabled();
    }

    /* ── CRM v2: Catalog / Statuses / Customer-Engagement model ──
       SALES-CRM-01: Sales staff get real, scoped access to the
       Lead → Booking → Payment-submission workflow (business requirement),
       NOT a global "sales can edit everything" grant:
        - catalogNodes/catalogNodeTypes/leadStatuses: READ only (Sales must
          browse the Catalog to pick a Program, and read Contact Status
          labels) — catalog/status ADMINISTRATION (create/edit/archive/move)
          stays isAdmin()-only, unchanged.
        - customers: read/create/update (identity fields plus the customer-
          level "Interested Programs" lead list, interestedProgramIds —
          INTEREST-01; never a registration, never touches engagements);
          delete stays isAdmin()-only (matches the existing cascade-delete
          scripts, untouched).
        - engagements: read/create (only into a non-enrolled, unpaid,
          non-archived state)/update (a fixed set of CRM-workflow fields,
          with paymentRecords restricted to "append one pending record" —
          see salesPaymentRecordsAppendOnlyPending() — and payment/
          pricingSnapshot restricted to their Course Price sub-fields only —
          see salesPaymentFieldsAllowed()/salesPricingSnapshotFieldsAllowed(),
          SALES-PRICE-01); delete stays isAdmin()-only. Sales can never set
          enrollmentStatus, archive an engagement, move it to a different
          customer/Program, or touch the legacy payment.confirmed/
          confirmedAt/reservationDeposit/installment* fields (still read as
          authoritative "is this paid" for an engagement with no real
          paymentRecords yet — see utils/paymentRecords.legacyRecordsFrom) —
          none of that is part of the required workflow, and the last one
          would otherwise be a way to fake a confirmed payment. ── */
    match /catalogNodes/{id} {
      allow read: if isAdmin() || isSalesStaff();
      allow write: if isAdmin();
    }
    match /catalogNodeTypes/{id} {
      allow read: if isAdmin() || isSalesStaff();
      allow write: if isAdmin();
    }
    match /leadStatuses/{id} {
      allow read: if isAdmin() || isSalesStaff();
      allow write: if isAdmin();
    }
    match /customers/{id} {
      allow read: if isAdmin() || isSalesStaff();
      allow create: if isAdmin() || isSalesStaff();
      allow update: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'normalizedPhone', 'secondaryPhones',
            'email', 'normalizedEmail', 'whatsapp', 'updatedAt',
            'interestedProgramIds',
            /* NEW-CUSTOMER-WORKFLOW-01 ("عملاء جدد"): lead-workflow fields only — the
               contact status (a leadStatuses id), the Program the customer says they
               will register in, sales notes, and the assigned employee. Still no
               archivedAt / authUid / createdAt, and still no delete. */
            'contactStatusId', 'contactStatusUpdatedAt', 'contactStatusUpdatedBy',
            'plannedProgramId', 'notes', 'assignedToId', 'assignedToName'
          ]));
      allow delete: if isAdmin();
    }
    match /engagements/{id} {
      allow read: if isAdmin() || isSalesStaff();
      allow create: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.get('enrollmentStatus', 'not_enrolled') == 'not_enrolled'
          && request.resource.data.get('paymentRecords', []).size() == 0
          && request.resource.data.get('archivedAt', null) == null);
      allow update: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusId', 'ownerId', 'salesNotes', 'studentProfile', 'priority',
            'payment', 'pricingSnapshot', 'timeline', 'updatedAt', 'paymentRecords'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentRecords'])
            || salesPaymentRecordsAppendOnlyPending(resource.data, request.resource.data)
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment'])
            || salesPaymentFieldsAllowed(resource.data, request.resource.data)
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pricingSnapshot'])
            || salesPricingSnapshotFieldsAllowed(resource.data, request.resource.data)
          ));
      allow delete: if isAdmin();
    }
    /* ── CRM-05 FINALIZATION: Follow-ups — admin gets everything (see all,
       create/edit/complete/cancel/assign any). Sales staff are scoped to
       their OWN queue only (resource.data.assignedTo == their uid) — this is
       the real Firestore-level boundary, not just a hidden Sidebar button.
       - create: sales may only create a follow-up assigned to themselves
         (assigning to someone else is an admin-only action, "Assign
         Follow-ups" in the spec).
       - update: sales may only touch a follow-up already assigned to them,
         and may not reassign it, or repoint customerId/engagementId/
         createdBy — only dueAt/note/status/result/completedAt/completedBy/
         updatedAt actually change through the app's own update paths.
       - delete: admin-only (the app never hard-deletes a follow-up, only
         sets status: "cancelled"). ── */
    match /followUps/{id} {
      allow read: if isAdmin() || (isSalesStaff() && resource.data.assignedTo == request.auth.uid);
      allow create: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid);
      allow update: if isAdmin()
        || (isSalesStaff()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.engagementId == resource.data.engagementId
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }
    match /tags/{id}                    { allow read, write: if isAdmin(); }
    /* SALES-CRM-01: Sales needs read-only access to field DEFINITIONS (not
       write) so EngagementDetailModal can show a customer's custom-field
       values (e.g. university, parent phone) — defining/editing the fields
       themselves stays isAdmin()-only, same split as catalogNodes above. */
    match /customFieldDefinitions/{id}  {
      allow read: if isAdmin() || isSalesStaff();
      allow write: if isAdmin();
    }
    match /dictionaries/{id}            { allow read, write: if isAdmin(); }
    match /importProfiles/{id}          { allow read, write: if isAdmin(); }
    match /importProfileVersions/{id}   { allow read, write: if isAdmin(); }
    /* LEAD-IMPORT-01: bulk "عملاء جدد" imports. Sales may only TRACK their own
       customer-lead import (create the batch, then finalize its counters) —
       the batch carries no engagement/payment/accounting data, and Sales still
       cannot read, rewrite, or delete any batch. Program imports (no kind)
       stay admin-only. */
    match /importBatches/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.get('kind', '') == 'customer_leads'
          && request.resource.data.get('importedBy', '') == request.auth.uid
          && request.resource.data.get('status', '') == 'committing'
          && request.resource.data.get('createdEngagementIds', []).size() == 0);
      allow update: if isAdmin()
        || (isSalesStaff()
          && resource.data.get('kind', '') == 'customer_leads'
          && resource.data.get('importedBy', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'createdCount', 'updatedCount', 'skippedCount', 'errorCount',
            'createdCustomerIds', 'updatedCustomerIds', 'interestsAddedCount', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    /* ── CRM-04: Accounting outbox — independent of the future Accounting
       module; same admin-only access as every other CRM collection. ── */
    match /accountingEvents/{id}        { allow read, write: if isAdmin(); }

    /* ── ACCOUNTING-01: Accounting Transactions — logically separate module,
       same admin-only access shape as everything else. Not yet connected
       to accountingEvents/CRM.
       ACCOUNTING-DELETE-01: create/read access is UNCHANGED (still both
       Admin and Accounting staff) — only `update` is split, so a normal
       field edit (amount/category/date/...) still works exactly as before
       for Accounting staff, but they cannot flip `isDeleted` either
       direction (soft-delete or restore) — that's Admin-only, enforced
       here, not just by hiding the button. `.get('isDeleted', false)`
       (not bare `.isDeleted`) is required because pre-existing documents
       from before this feature have no isDeleted field at all — the
       approved spec's own "missing isDeleted == false" rule, applied at
       the rules layer too. Real document deletion (`allow delete`) is left
       exactly as it already was — unrelated to this feature, and narrowing
       it would break the existing, separately-approved Customer/Track
       deletion cascades (deleteCustomer.js/deleteTrack.js), which
       legitimately hard-delete a customer's own accountingTransactions as
       part of removing that customer entirely. This feature's own delete
       action never calls a Firestore delete — only `update`. ── */
    match /accountingTransactions/{id} {
      allow read, create, delete: if isAdmin() || isAccountingStaff();
      allow update: if isAdmin()
        || (isAccountingStaff()
          && request.resource.data.get('isDeleted', false) == resource.data.get('isDeleted', false));
    }

    /* ── ACCOUNTING-DELETE-01: immutable delete/restore audit trail for
       Accounting Transactions. Admin-only end to end, including read —
       existing policy grants Accounting staff no audit-history access, and
       none is added here. No update/delete for ANYONE, including Admin —
       an audit trail that could be edited or removed after the fact isn't
       an audit trail; only AccountingContext.deleteTransaction/
       restoreTransaction ever write here, and only ever via `create`. ── */
    match /accountingTransactionAudit/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
