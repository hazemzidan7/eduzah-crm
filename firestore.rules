rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    function bootstrapAdminEnabled() {
      return exists(/databases/$(database)/documents/settings/bootstrap)
        && get(/databases/$(database)/documents/settings/bootstrap).data.enabled == true;
    }

    /* ── ACCOUNTING-02: the one other role allowed into Accounting
       (view/add/edit transactions) — mirrors isAdmin(), no new RBAC. ── */
    function isAccountingStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'accounting';
    }

    /* ── CRM-05 FINALIZATION: the one role allowed into Follow-ups without
       full CRM/admin access — mirrors isAccountingStaff() exactly, same "one
       more allowed role string" shape, no new RBAC system. Investigation
       confirmed no existing role can be reused for this: every other role
       (user/student/instructor/accounting) is unrelated to CRM work, and
       "admin" is the only role that currently does Sales work in production
       — there is no way to give a subset of admins Follow-up-only visibility
       without a role distinct from admin. Scoped to followUps only; every
       other CRM collection (customers/engagements/etc.) below is untouched
       and stays admin-only. ── */
    function isSalesStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'sales';
    }

    /* ── users ───────────────────────────────────────── */
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && bootstrapAdminEnabled();
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email)
      );
      allow delete: if isAdmin();
    }

    /* ── settings (bootstrap flag + CRM seedState) ───── */
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() || bootstrapAdminEnabled();
      allow delete: if isAdmin() || bootstrapAdminEnabled();
    }

    /* ── CRM v2: Catalog / Statuses / Customer-Engagement model ── */
    match /catalogNodes/{id}            { allow read, write: if isAdmin(); }
    match /catalogNodeTypes/{id}        { allow read, write: if isAdmin(); }
    match /leadStatuses/{id}            { allow read, write: if isAdmin(); }
    match /customers/{id}               { allow read, write: if isAdmin(); }
    match /engagements/{id}             { allow read, write: if isAdmin(); }
    /* ── CRM-05 FINALIZATION: Follow-ups — admin gets everything (see all,
       create/edit/complete/cancel/assign any). Sales staff are scoped to
       their OWN queue only (resource.data.assignedTo == their uid) — this is
       the real Firestore-level boundary, not just a hidden Sidebar button.
       - create: sales may only create a follow-up assigned to themselves
         (assigning to someone else is an admin-only action, "Assign
         Follow-ups" in the spec).
       - update: sales may only touch a follow-up already assigned to them,
         and may not reassign it, or repoint customerId/engagementId/
         createdBy — only dueAt/note/status/result/completedAt/completedBy/
         updatedAt actually change through the app's own update paths.
       - delete: admin-only (the app never hard-deletes a follow-up, only
         sets status: "cancelled"). ── */
    match /followUps/{id} {
      allow read: if isAdmin() || (isSalesStaff() && resource.data.assignedTo == request.auth.uid);
      allow create: if isAdmin()
        || (isSalesStaff()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid);
      allow update: if isAdmin()
        || (isSalesStaff()
          && resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.engagementId == resource.data.engagementId
          && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }
    match /tags/{id}                    { allow read, write: if isAdmin(); }
    match /customFieldDefinitions/{id}  { allow read, write: if isAdmin(); }
    match /dictionaries/{id}            { allow read, write: if isAdmin(); }
    match /importProfiles/{id}          { allow read, write: if isAdmin(); }
    match /importProfileVersions/{id}   { allow read, write: if isAdmin(); }
    match /importBatches/{id}           { allow read, write: if isAdmin(); }

    /* ── CRM-04: Accounting outbox — independent of the future Accounting
       module; same admin-only access as every other CRM collection. ── */
    match /accountingEvents/{id}        { allow read, write: if isAdmin(); }

    /* ── ACCOUNTING-01: Accounting Transactions — logically separate module,
       same admin-only access shape as everything else. Not yet connected
       to accountingEvents/CRM. ── */
    match /accountingTransactions/{id}  { allow read, write: if isAdmin() || isAccountingStaff(); }

    match /{document=**} { allow read, write: if false; }
  }
}
